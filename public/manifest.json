{
  "manifest_version": 3,
  "name": "CQU 快捷登录",
  "version": "0.4.9",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "identity"
  ],
  "externally_connectable": {
    "matches": [
      "https://auth.cqu.moe/*"
    ]
  },
  "host_permissions": [
    "https://auth.cqu.moe/*",
    "https://sso.cqu.edu.cn/*",
    "https://p.cqu.moe/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://auth.cqu.moe https://p.cqu.moe;"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sso.cqu.edu.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "incognito": "not_allowed",
  "description": "为重庆大学统一认证同步登录状态，减少重复登录；支持设备管理、手动登录和授权恢复。需要 CQU.MOE Auth 账号及 QuickLogin 使用资格。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
