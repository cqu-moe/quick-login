{
  "manifest_version": 3,
  "name": "CQU 快捷登录",
  "version": "0.2.5",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "identity"
  ],
  "externally_connectable": {
    "matches": [
      "https://auth.cqu.moe/*"
    ]
  },
  "host_permissions": [
    "https://auth.cqu.moe/*",
    "https://sso.cqu.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sso.cqu.edu.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed"
}
